// Copy to Secrets.xcconfig (git-ignored) and fill in the values of your
// Google Cloud OAuth client of type "Desktop app".
// Google treats desktop client secrets as non-confidential, but keep them
// out of the repository anyway.
GOOGLE_OAUTH_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET = GOCSPX-replace-me
